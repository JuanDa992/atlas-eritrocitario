{
  "name": "atlas-eritrocitario",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "description": "Atlas digital de morfología eritrocitaria en caninos y felinos (beta)",
  "scripts": {
    "dev": "astro dev",
    "dev:revision": "node scripts/revision.mjs dev",
    "build": "astro build && pagefind --site dist && node scripts/verificar-csp.mjs",
    "build:revision": "node scripts/revision.mjs build",
    "preview": "astro preview",
    "preview:revision": "node scripts/revision.mjs preview",
    "migrar": "python scripts/migrar_preliminar.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "astro": "^7.4.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "pagefind": "^1.4.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

---
import { getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Estado from '../../components/Estado.astro';
import { url, morfologias, CATEGORIAS, REFERENCIAS, TIPO } from '../../lib/datos';

export async function getStaticPaths() {
  const lista = await morfologias();
  return lista.map((m, i) => ({
    params: { slug: m.id },
    props: { m, anterior: lista[i - 1] ?? null, siguiente: lista[i + 1] ?? null },
  }));
}

const { m, anterior, siguiente } = Astro.props;
const d = m.data;
const { Content } = await render(m);

const grande = d.imagen ? await getImage({ src: d.imagen.src, width: 1800, format: 'webp' }) : null;
const difs = (await Promise.all(d.diferenciales.map((r) => getEntry(r)))).filter(Boolean);
const rels = (await Promise.all(d.relacionadas.map((r) => getEntry(r)))).filter(Boolean);
const descripcion = `${d.titulo}: ${d.rasgo}. Ficha del atlas de morfología eritrocitaria en caninos y felinos.`;
---

<Base titulo={d.titulo} descripcion={descripcion}>
  <p class="migas">
    <a href={url('morfologias')}>Consultar</a> › {CATEGORIAS[d.categoria]} › {d.codigo}
  </p>

  <article class="ficha" data-pagefind-body>
    <header>
      <p class="codigo">{d.codigo} · {d.grupo}</p>
      <h1 data-pagefind-meta="title">{d.titulo}</h1>
      <p class="ingles">{d.nombreIngles}</p>
      {d.sinonimos.length > 0 && <p class="codigo">También llamado: {d.sinonimos.join(', ')}</p>}
      <div class="badges" data-pagefind-ignore>
        <Estado estado={d.estadoRevision} />
        {d.felinoPendiente && <span class="badge pendiente"><span aria-hidden="true">○</span> Felino pendiente</span>}
      </div>
    </header>

    <figure class="visor" data-pagefind-ignore>
      {
        d.imagen && grande ? (
          <>
            <div class="marco">
              <button type="button" class="ampliar" data-grande={grande.src} aria-label={`Ampliar la imagen de ${d.titulo}`}>
                <Image src={d.imagen.src} alt={d.imagen.alt} widths={[480, 800, 1200]} sizes="(max-width: 60rem) 92vw, 800px" loading="eager" />
              </button>
            </div>
            <figcaption>
              {d.imagen.pie}
              {d.felinoPendiente && <span class="aviso-felino"> ○ Fotografía felina pendiente.</span>}
            </figcaption>
          </>
        ) : (
          <div class="sin-foto">Imagen pendiente para esta morfología.</div>
        )
      }
    </figure>

    <aside class="rasgo" aria-label="Rasgo clave">
      <b>Rasgo clave</b>
      <p>{d.rasgo}.</p>
    </aside>

    <dl class="trio">
      <div>
        <dt>Igual en perro y gato</dt>
        <dd>{d.igual}</dd>
      </div>
      <div>
        <dt>Qué cambia en el gato</dt>
        <dd>{d.gato}</dd>
      </div>
      <div>
        <dt>Significado clínico</dt>
        <dd>{d.clinico}</dd>
      </div>
    </dl>

    <div class="prose">
      <Content />
    </div>

    {
      difs.length > 0 && (
        <section data-pagefind-ignore>
          <h2>No confundir con</h2>
          <ul class="pildoras">
            {difs.map((x) => (
              <li>
                <a href={url(`morfologias/${x!.id}`)}>{(x as any).data.titulo}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      rels.length > 0 && (
        <section data-pagefind-ignore>
          <h2>Enfermedades y contextos relacionados</h2>
          <ul class="pildoras">
            {rels.map((x) => (
              <li>
                <a href={url(`enfermedades/${x!.id}`)}>
                  {(x as any).data.titulo}
                  <span class="tipo">{TIPO[(x as any).data.tipo as keyof typeof TIPO]}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      (d.pendientes.length > 0 || d.notas.length > 0) && (
        <details class="plegable" data-pagefind-ignore>
          <summary>Estado de esta ficha: pendientes y notas editoriales</summary>
          <p>Versión de contenido {d.versionContenido} · actualizada el {d.fechaContenido} · borrador en revisión.</p>
          {d.notas.length > 0 && (
            <>
              <h3>Notas editoriales</h3>
              <ul class="lista-simple">{d.notas.map((n) => <li>{n}</li>)}</ul>
            </>
          )}
          {d.pendientes.length > 0 && (
            <>
              <h3>Pendientes</h3>
              <ul class="lista-simple">{d.pendientes.map((n) => <li>{n}</li>)}</ul>
            </>
          )}
        </details>
      )
    }

    <section class="refs" data-pagefind-ignore>
      <h2>Referencias</h2>
      <ul class="lista-simple">
        {d.referencias.map((r) => <li>{REFERENCIAS[r]?.completa ?? r}</li>)}
      </ul>
      <p>Las obras citadas dentro de la tesis se conservan como citas secundarias hasta consultar la fuente original.</p>
    </section>

    <nav class="anterior-siguiente" aria-label="Fichas vecinas" data-pagefind-ignore>
      <span>{anterior && <a href={url(`morfologias/${anterior.id}`)}>← {anterior.data.titulo}</a>}</span>
      <span>{siguiente && <a href={url(`morfologias/${siguiente.id}`)}>{siguiente.data.titulo} →</a>}</span>
    </nav>
  </article>

  <dialog class="lightbox" id="lightbox" aria-label="Imagen ampliada">
    <div class="barra">
      <span>{d.titulo} · pulse la imagen para acercar</span>
      <button type="button" id="cerrar">Cerrar</button>
    </div>
    <div class="lienzo"><img id="lightbox-img" alt={d.imagen?.alt ?? ''} /></div>
  </dialog>

  <script is:inline>
    (function () {
      var b = document.querySelector('button.ampliar');
      var dlg = document.getElementById('lightbox');
      if (!b || !dlg || typeof dlg.showModal !== 'function') return;
      var img = document.getElementById('lightbox-img');
      b.addEventListener('click', function () {
        img.src = b.getAttribute('data-grande');
        img.classList.remove('zoom');
        dlg.showModal();
      });
      img.addEventListener('click', function () {
        img.classList.toggle('zoom');
      });
      document.getElementById('cerrar').addEventListener('click', function () {
        dlg.close();
      });
      dlg.addEventListener('click', function (e) {
        if (e.target === dlg) dlg.close();
      });
    })();
  </script>
</Base>
